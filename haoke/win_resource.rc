#pragma code_page(65001)
#include <winuser.h>
#include <winver.h>
#include "haoke_version_resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
VLC_ICON ICON "vlc.ico"
1 VERSIONINFO
FILEVERSION HAOKE_VERSION_NUMBERS
PRODUCTVERSION HAOKE_VERSION_NUMBERS
FILETYPE VFT_APP
FILEOS VOS_NT_WINDOWS32
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "VideoLAN; Haoke modifications"
   VALUE "ProductName", "VLC media player"
   VALUE "ProductVersion", HAOKE_VERSION_NAME
   VALUE "InternalName", "vlc"
   VALUE "OriginalFilename", "vlc.exe"
   VALUE "FileVersion", HAOKE_FILE_VERSION
   VALUE "FileDescription", "VLC media player - Haoke optimized edition"
   VALUE "LegalCopyright", "Copyright VideoLAN and VLC Authors; Haoke modifications 2026"
   VALUE "LegalTrademarks", "VLC media player and VideoLAN are registered trademarks of VideoLAN"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
/* A distinct Chinese resource lets Windows select the localized metadata,
 * rather than leaving both translations inside an English-only resource. */
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
1 VERSIONINFO
FILEVERSION HAOKE_VERSION_NUMBERS
PRODUCTVERSION HAOKE_VERSION_NUMBERS
FILETYPE VFT_APP
FILEOS VOS_NT_WINDOWS32
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "080404b0"
  BEGIN
   VALUE "CompanyName", "VideoLAN；浩科优化"
   VALUE "ProductName", "全能影音播放器"
   VALUE "ProductVersion", HAOKE_VERSION_NAME
   VALUE "InternalName", "vlc"
   VALUE "OriginalFilename", "vlc.exe"
   VALUE "FileVersion", HAOKE_FILE_VERSION
   VALUE "FileDescription", "全能影音播放器 - 浩科优化版"
   VALUE "LegalCopyright", "Copyright VideoLAN and VLC Authors；浩科修改 2026"
   VALUE "LegalTrademarks", "VLC media player、VideoLAN 商标归 VideoLAN 所有"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x804, 1200
 END
END
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
